{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fleet-kit.invalid/run-state-v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "run-state-v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "task_revision": {
      "type": "integer",
      "minimum": 1
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "dirty_snapshot": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "commit",
        "dirty_snapshot"
      ]
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "task_revision": {
            "type": "integer",
            "minimum": 1
          },
          "attempt": {
            "type": "integer",
            "minimum": 1
          },
          "state": {
            "enum": [
              "planned",
              "ready",
              "running",
              "completed",
              "verified",
              "accepted",
              "blocked",
              "failed",
              "cancelled"
            ]
          },
          "agent_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "command_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "changed_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "writer": {
            "type": "boolean"
          }
        },
        "required": [
          "task_id",
          "task_revision",
          "attempt",
          "state",
          "agent_id",
          "command_ids",
          "changed_paths",
          "evidence",
          "writer"
        ]
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "safe_next_action": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "task_revision",
    "baseline",
    "decisions",
    "tasks",
    "unresolved",
    "safe_next_action"
  ]
}
